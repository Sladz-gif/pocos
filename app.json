{
  "expo": {
    "name": "AmanA",
    "slug": "pocos-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./src/assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.amana.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundImage": "./src/assets/android-icon-background.png",
        "monochromeImage": "./src/assets/android-icon-monochrome.png"
      },
      "package": "com.amana.app",
      "predictiveBackGestureEnabled": false,
      "newArchEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ],
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./src/assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24,
            "extraGradleProperties": {
              "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=512m",
              "org.gradle.logging.level": "info"
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "amana-app",
    "extra": {
      "eas": {
        "projectId": "c27100bd-47ea-44ca-aede-edc1845197a8"
      },
      "EXPO_PUBLIC_SUPABASE_URL": "https://incnvieiiakiqjtgsvkp.supabase.co",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImluY252aWVpaWFraXFqdGdzdmtwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzk1NjA2NzEsImV4cCI6MjA5NTEzNjY3MX0.ctuw0Twx5EPbh37q_ezUvNMEXp051KDcO4nwzvluykU"
    },
    "owner": "tttttt2222s-team"
  }
}
